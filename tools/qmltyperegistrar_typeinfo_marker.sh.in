#!/usr/bin/env bash
# Qt 6.10's qmltyperegistrar fails while writing typeinfo under Flatpak
# Builder's no-FUSE rofiles mode. Keep the required C++ registration output,
# and write the valid tooling-only empty marker that Qt emits for modules with
# no C++ type metadata.

set -euo pipefail

real_registrar='@MIXXX_QMLTYPEREGISTRAR_REAL@'
requested_typeinfo=''
registration_source=''
expect_registration_source=0
rewritten_args=()

for argument in "$@"; do
    if ((expect_registration_source)); then
        registration_source="$argument"
        expect_registration_source=0
        rewritten_args+=("$argument")
        continue
    fi

    case "$argument" in
        --generate-qmltypes=*)
            requested_typeinfo="${argument#--generate-qmltypes=}"
            ;;
        -o)
            expect_registration_source=1
            rewritten_args+=("$argument")
            ;;
        *)
            rewritten_args+=("$argument")
            ;;
    esac
done

if [[ -z "$requested_typeinfo" || -z "$registration_source" ]]; then
    exec "$real_registrar" "$@"
fi

"$real_registrar" "${rewritten_args[@]}"

[[ -s "$registration_source" ]] || {
    echo "Error: qmltyperegistrar did not produce C++ registration source." >&2
    exit 1
}

mkdir -p -- "$(dirname -- "$requested_typeinfo")"
cat >"$requested_typeinfo" <<'EOF'
import QtQuick.tooling 1.2

// Typeinfo is unavailable in the no-FUSE Flatpak Builder environment.
// Runtime registration is generated separately by qmltyperegistrar.
Module {}
EOF
echo "Qt QML typeinfo generation replaced with a valid tooling-only marker."
